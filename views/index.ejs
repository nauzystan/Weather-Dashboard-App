<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Weather App</title>
    <script>
        if (localStorage.getItem("theme") === "Light") {
            document.documentElement.classList.add("light-theme");
        }
    </script>
    <link rel="stylesheet" href="/styles/main.css" />
</head>

<body>

    <div class="shooting-star star-1"></div>
    <div class="shooting-star star-2"></div>
    <div class="shooting-star star-3"></div>

    <div class="asteroid asteroid-1"></div>
    <div class="asteroid asteroid-2"></div>

    <div id="weather-effects"></div>

    <div class="app-layout">

        <aside class="sidebar">

            <div class="sidebar-badge">
                Weather Dashboard App
            </div>

            <h1 class="hero-title">
                Next-Level Weather Experience
            </h1>

            <p class="hero-subtitle">
                Real-time data. Beautiful visuals.
                Powerful features.
            </p>

            <ul class="feature-list">
                <li>✓ Real-time Weather Data</li>
                <li>✓ Interactive Space Theme</li>
                <li>✓ Hourly Forecasts</li>
                <li>✓ 7-Day Forecasts</li>
                <li>✓ Search History</li>
                <li>✓ Favorites</li>
            </ul>

            <a href="https://www.linkedin.com/in/chinonso-gabriel-535b42176/" target="_blank" class="portfolio-btn">
                ⭐ Connect with the Developer
            </a>

        </aside>

        <main class="dashboard">

            <div class="container">

                <header class="header">

                    <h1>🌤 Weather Dashboard</h1>

                    <nav class="top-nav">
                        <a href="#" id="dashboardLink" class="active">Dashboard</a>

                        <a href="/favorites">Favorites</a>

                        <a href="/history">History</a>

                        <a href="/settings">Settings</a>
                    </nav>

                </header>

                <section class="form-section">
                    <form action="/get-forecast" method="POST" class="weather-form">

                        <div class="search-toolbar">

                            <input type="text" name="city" placeholder="🔍 Search city..." required />

                            <input type="text" name="code" placeholder="Country" required />

                            <button type="submit" id="submitBtn" class="search-btn">
                                Search
                            </button>

                            <button type="button" id="locationBtn" class="location-btn">
                                📍
                            </button>

                        </div>

                    </form>
                </section>

                <section class="result-section">
                    <% if (content && content.main) { %>

                        <div class="weather-card">
                            <div class="location-header">

                                <div>

                                    <h2>
                                        <%= content.name %>, <%= content.sys.country %>
                                    </h2>

                                    <p class="current-time">
                                        <%= new Date((content.dt + content.timezone) * 1000) .toLocaleString("en-US", {
                                            weekday: "short" , day: "numeric" , month: "short" , hour: "numeric" ,
                                            minute: "2-digit" }) %>
                                    </p>

                                </div>

                                <form action="/favorite" method="POST">

                                    <input type="hidden" name="city" value="<%= content.name %>" />

                                    <input type="hidden" name="country" value="<%= content.sys.country %>" />

                                    <button class="favorite-btn">
                                        ⭐
                                    </button>

                                </form>

                            </div>

                            <div class="weather-main">

                                <img class="weather-icon"
                                    src="https://openweathermap.org/img/wn/<%= content.weather[0].icon %>@2x.png"
                                    alt="weather icon" />

                                <div>

                                    <h1>
                                        <span class="temp" data-c="<%= content.main.temp %>">
                                            <%= content.main.temp.toFixed(0) %>°C
                                        </span>
                                    </h1>

                                    <h3 class="weather-status">
                                        <%= content.weather[0].description %>
                                    </h3>

                                </div>

                            </div>

                            <!-- <p class="description">
                                        <%= content.weather[0].description %>
                                    </p> -->

                            <div class="weather-details">

                                <div>
                                    <span>Feels Like</span>
                                    <p>
                                        <span class="temp" data-c="<%= content.main.feels_like %>">
                                            <%= Math.round(content.main.feels_like) %>°C
                                        </span>
                                    </p>
                                </div>

                                <div>
                                    <span>Humidity</span>
                                    <p>
                                        <%= content.main.humidity %>%
                                    </p>
                                </div>

                                <div>
                                    <span>Wind</span>
                                    <p>
                                        <%= content.wind.speed %> m/s
                                    </p>
                                </div>

                                <div>
                                    <span>Visibility</span>
                                    <p>
                                        <%= content.visibility / 1000 %> km
                                    </p>
                                </div>

                                <div>
                                    <span>Pressure</span>
                                    <p>
                                        <%= content.main.pressure %> hPa
                                    </p>
                                </div>

                                <div>
                                    <span>Sunrise</span>

                                    <p>
                                        <%= new Date(content.sys.sunrise * 1000).toLocaleTimeString([], {
                                            hour: "numeric" , minute: "2-digit" }) %>
                                    </p>
                                </div>

                                <div>
                                    <span>Sunset</span>

                                    <p>
                                        <%= new Date(content.sys.sunset * 1000).toLocaleTimeString([], { hour: "numeric"
                                            , minute: "2-digit" }) %>
                                    </p>
                                </div>

                                <div>
                                    <span>Air Quality</span>

                                    <p>

                                        <% const levels=[ "" , "Good" , "Fair" , "Moderate" , "Poor" , "Very Poor" ]; %>

                                            <%= levels[airQuality.list[0].main.aqi] %>

                                    </p>

                                </div>

                            </div>

                        </div>

                        <div class="forecast-row">
                            <% if (forecast) { %>

                                <div class="hourly-card">

                                    <h3>Hourly Forecast</h3>

                                    <div class="hourly-grid">

                                        <% forecast.list.slice(0, 6).forEach(hour=> { %>

                                            <div class="hour-item">

                                                <p>
                                                    <%= new Date(hour.dt_txt).toLocaleTimeString([], { hour: "numeric"
                                                        }) %>
                                                </p>

                                                <span>
                                                    <img src="https://openweathermap.org/img/wn/<%= hour.weather[0].icon %>@2x.png"
                                                        alt="weather icon" width="38" />
                                                </span>

                                                <h4>
                                                    <span class="temp" data-c="<%= hour.main.temp %>">
                                                        <%= Math.round(hour.main.temp) %>°C
                                                    </span>
                                                </h4>

                                            </div>

                                            <% }) %>

                                    </div>

                                </div>
                                <% } %>

                                    <% if (dailyForecast && dailyForecast.length) { %>

                                        <div class="forecast-section">

                                            <h3>4-Day Forecast</h3>

                                            <div class="forecast-grid">

                                                <% dailyForecast.slice(0, 4).forEach(day=> { %>

                                                    <div class="forecast-card">

                                                        <p>
                                                            <%= new Date(day.dt_txt).toLocaleDateString([], {
                                                                weekday: "short" }) %>
                                                        </p>

                                                        <img src="https://openweathermap.org/img/wn/<%= day.weather[0].icon %>@2x.png"
                                                            alt="weather icon" />

                                                        <h4>
                                                            <span class="temp" data-c="<%= day.main.temp %>">
                                                                <%= Math.round(day.main.temp) %>°C
                                                            </span>
                                                        </h4>

                                                        <small>
                                                            <%= day.weather[0].description %>
                                                        </small>

                                                    </div>

                                                    <% }) %>

                                            </div>

                                        </div>

                                        <% } %>
                        </div>
                        <% } else if (content) { %>

                            <div class="error-card">

                                <h2>⚠️</h2>

                                <p>
                                    <%= content %>
                                </p>

                            </div>

                            <% } %>
                </section>

            </div>

        </main>

    </div>

    <div id="loading-screen">
        <div class="spinner"></div>
        <p>Loading weather...</p>
    </div>

    <div id="toast"></div>

    <script>
        const lastCity = "<%= typeof lastCity !== 'undefined' ? lastCity : '' %>";
        const lastCountry = "<%= typeof lastCountry !== 'undefined' ? lastCountry : '' %>";
        const weatherMain =
            "<%= content && content.weather ? content.weather[0].main : '' %>";
    </script>

    <script>
        if (lastCity && lastCountry) {

            localStorage.setItem("lastCity", lastCity);
            localStorage.setItem("lastCountry", lastCountry);

        }

        const locationBtn = document.getElementById("locationBtn");

        function getLocation() {

            if (!navigator.geolocation) {
                alert("Geolocation is not supported by your browser.");
                return;
            }

            navigator.geolocation.getCurrentPosition(

                (position) => {

                    localStorage.setItem("locationPermission", "allowed");

                    const latitude = position.coords.latitude;
                    const longitude = position.coords.longitude;

                    window.location.href =
                        `/current-location?lat=${latitude}&lon=${longitude}`;

                },

                () => {

                    localStorage.setItem("locationPermission", "denied");

                }

            );

        }

        // Button still works
        locationBtn.addEventListener("click", getLocation);

        // Automatically get location only if no weather is already displayed
        window.onload = function () {

            const weatherCard = document.querySelector(".weather-card");
            const errorCard = document.querySelector(".error-card");

            if (weatherCard || errorCard) return;

            const lastCity = localStorage.getItem("lastCity");
            const lastCountry = localStorage.getItem("lastCountry");

            if (lastCity && lastCountry) {

                window.location.href =
                    `/favorite-weather?city=${lastCity}&country=${lastCountry}`;

                return;

            }

            const permission =
                localStorage.getItem("locationPermission");

            if (permission === "denied") return;

            getLocation();

        };

        const weatherForm = document.querySelector(".weather-form");

        if (weatherForm) {
            weatherForm.addEventListener("submit", () => {
                document.getElementById("loading-screen").style.display = "flex";
            });
        }

        function applyWeatherEffects() {

            switch (weatherMain) {

                case "Clear":
                    createSunRays();
                    break;

                case "Rain":
                case "Drizzle":
                    createRain();
                    break;

                case "Snow":
                    createSnow();
                    break;

                case "Thunderstorm":
                    createThunder();
                    break;

            }

        }

        const animationsEnabled = localStorage.getItem("animations") !== "Off";

        if (animationsEnabled) {
            applyWeatherEffects();
        }

        function createRain() {

            const container =
                document.getElementById("weather-effects");

            for (let i = 0; i < 150; i++) {

                const drop = document.createElement("div");

                drop.className = "rain-drop";

                drop.style.left = Math.random() * 100 + "vw";

                drop.style.animationDelay =
                    Math.random() * 2 + "s";

                drop.style.animationDuration =
                    0.8 + Math.random() + "s";

                container.appendChild(drop);

            }

        }

        function createSunRays() {

            const container = document.getElementById("weather-effects");

            const sun = document.createElement("div");
            sun.className = "sun";

            const rays = document.createElement("div");
            rays.className = "sun-rays";

            container.appendChild(rays);
            container.appendChild(sun);

        }

        function createSnow() {

            const container =
                document.getElementById("weather-effects");

            for (let i = 0; i < 80; i++) {

                const flake = document.createElement("div");

                flake.className = "snowflake";

                flake.innerHTML = "❄";

                flake.style.left =
                    Math.random() * 100 + "vw";

                flake.style.animationDelay =
                    Math.random() * 5 + "s";

                flake.style.fontSize =
                    10 + Math.random() * 15 + "px";

                container.appendChild(flake);

            }

        }

        function createThunder() {

            const container =
                document.getElementById("weather-effects");

            const flash = document.createElement("div");

            flash.className = "lightning-flash";

            container.appendChild(flash);

        }

        const dashboardLink = document.getElementById("dashboardLink");

        dashboardLink?.addEventListener("click", (e) => {
            e.preventDefault();

            const city = localStorage.getItem("lastCity");
            const country = localStorage.getItem("lastCountry");

            if (city && country) {
                window.location.href = `/favorite-weather?city=${city}&country=${country}`;
            } else {
                window.location.href = "/";
            }
        });

    </script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const unit = localStorage.getItem("unit") || "C";

            if (unit === "F") {
                document.querySelectorAll(".temp").forEach(el => {
                    const c = Number(el.dataset.c);
                    const f = (c * 9 / 5 + 32).toFixed(0);
                    el.textContent = `${f}°F`;
                });
            }
        });

        function showToast(message) {
            const toast = document.getElementById("toast");

            toast.textContent = message;

            toast.classList.add("show");

            setTimeout(() => {
                toast.classList.remove("show");
            }, 2500);
        }

        const params = new URLSearchParams(window.location.search);

        if (params.get("toast") === "added") {
            showToast("⭐ Added to Favorites");
        }
    </script>



</body>




</html>