<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Favorites</title>

    <script>
        if (localStorage.getItem("theme") === "Light") {
            document.documentElement.classList.add("light-theme");
        }
    </script>

    <link rel="stylesheet" href="/styles/main.css">
</head>

<body>
    <div class="shooting-star star-1"></div>
    <div class="shooting-star star-2"></div>
    <div class="shooting-star star-3"></div>

    <div class="asteroid asteroid-1"></div>
    <div class="asteroid asteroid-2"></div>

    <script>
        if (localStorage.getItem("animations") === "Off") {
            document.querySelectorAll(".shooting-star,.asteroid").forEach(el => {
                el.style.display = "none";
            });
        }
    </script>

    <div id="weather-effects"></div>

    <main class="dashboard">
        <div class="container">

            <header class="header">

                <h1>⚙️ Settings</h1>

                <nav class="top-nav">
                    <a href="#" id="dashboardLink">Dashboard</a>
                    <a href="/favorites">Favorites</a>
                    <a href="/history">History</a>
                    <a href="/settings" class="active">Settings</a>
                </nav>

            </header>

            <div class="settings-grid">

                <div class="setting-card">
                    <div>
                        <h3>Temperature Unit</h3>
                        <p>Choose your preferred unit.</p>
                    </div>

                    <button id="unitToggle" class="setting-btn">°C</button>
                </div>

                <div class="setting-card">
                    <div>
                        <h3>Theme</h3>
                        <p>Switch between dark and light mode.</p>
                    </div>

                    <button id="themeToggle" class="setting-btn">Dark</button>
                </div>

                <div class="setting-card">
                    <div>
                        <h3>Weather Animations</h3>
                        <p>Enable or disable visual effects.</p>
                    </div>

                    <button id="animationToggle" class="setting-btn">On</button>
                </div>

            </div>



        </div>

    </main>

    <div id="toast"></div>

    <script>
        // Navigate back to the last searched location when Dashboard is clicked
        const dashboardLink = document.getElementById("dashboardLink");

        dashboardLink?.addEventListener("click", (e) => {
            e.preventDefault();

            // Retrieve the last searched location from local storage
            const lat = localStorage.getItem("lastLat");
            const lon = localStorage.getItem("lastLon");

            // If a previous search exists, reload it; otherwise return to the home page
            if (lat && lon) {
                window.location.href = `/favorite-weather?lat=${lat}&lon=${lon}`;
            } else {
                window.location.href = "/";
            }
        });

        // Settings buttons
        const unitBtn = document.getElementById("unitToggle");
        const themeBtn = document.getElementById("themeToggle");
        const animationBtn = document.getElementById("animationToggle");

        /* ===========================
           Temperature Preference
        =========================== */

        // Load the user's preferred temperature unit
        let unit = localStorage.getItem("unit") || "C";
        unitBtn.textContent = `°${unit}`;

        // Toggle between Celsius and Fahrenheit
        unitBtn?.addEventListener("click", () => {
            unit = unit === "C" ? "F" : "C";

            // Save preference
            localStorage.setItem("unit", unit);

            // Update button label
            if (unitBtn) {
                unitBtn.textContent = `°${unit}`;
            }

            // Future enhancement:
            // applyUnit();

            showToast(`Temperature changed to °${unit}`);
        });

        /* ===========================
           Theme Preference
        =========================== */

        // Load the user's preferred theme
        let theme = localStorage.getItem("theme") || "Dark";
        themeBtn.textContent = theme;

        // Apply the saved theme immediately
        applyTheme();

        // Toggle between Dark and Light themes
        themeBtn?.addEventListener("click", () => {
            theme = theme === "Dark" ? "Light" : "Dark";

            // Save preference
            localStorage.setItem("theme", theme);

            // Update button label
            if (themeBtn) {
                themeBtn.textContent = theme;
            }

            // Apply the selected theme
            applyTheme();

            showToast(`${theme} mode enabled`);
        });

        /**
         * Apply the currently selected theme
         */
        function applyTheme() {
            document.documentElement.classList.toggle(
                "light-theme",
                theme === "Light"
            );
        }

        /* ===========================
           Weather Animations
        =========================== */

        // Load the user's animation preference
        let animations = localStorage.getItem("animations") || "On";
        animationBtn.textContent = animations;

        // Apply saved animation settings
        applyAnimations();

        // Toggle weather animations
        animationBtn?.addEventListener("click", () => {
            animations = animations === "On" ? "Off" : "On";

            // Save preference
            localStorage.setItem("animations", animations);

            // Update button label
            if (animationBtn) {
                animationBtn.textContent = animations;
            }

            // Apply animation settings
            applyAnimations();

            showToast(`Animations ${animations}`);
        });

        /**
         * Show or hide background animations
         */
        function applyAnimations() {
            const shootingStars = document.querySelectorAll(".shooting-star");
            const asteroids = document.querySelectorAll(".asteroid");

            if (animations === "Off") {
                shootingStars.forEach(el => el.style.display = "none");
                asteroids.forEach(el => el.style.display = "none");
            } else {
                shootingStars.forEach(el => el.style.display = "");
                asteroids.forEach(el => el.style.display = "");
            }
        }

        /* ===========================
           Toast Notification
        =========================== */

        /**
         * Display a temporary notification message
         * @param {string} message - Text displayed inside the toast
         */
        function showToast(message) {
            const toast = document.getElementById("toast");

            toast.textContent = message;
            toast.classList.add("show");

            setTimeout(() => {
                toast.classList.remove("show");
            }, 2500);
        }
    </script>



</body>

</html>